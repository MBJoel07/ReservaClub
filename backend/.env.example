# Copiar a .env y completar. Nunca commitear el .env real.

# Conexion a PostgreSQL (local o Neon)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/reservaclub

# Firma de los JWT. En produccion, un valor largo y aleatorio.
JWT_SECRET=cambiar-este-secreto

# Origen permitido por CORS (la URL del frontend)
FRONTEND_URL=http://localhost:5173

# Admin inicial: se crea solo si todavia no existe ningun admin
INITIAL_ADMIN_EMAIL=admin@reservaclub.com
INITIAL_ADMIN_PASSWORD=cambiar-esta-password

PORT=3000
